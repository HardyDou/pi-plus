{
  "name": "pi-farm",
  "version": "0.71.0",
  "description": "tmux session manager for pi agents — YAML config, reboot autostart, cron, todo panel, and sessions on other machines over ssh",
  "type": "module",
  "bin": {
    "pp": "bin/pp",
    "pifarm": "bin/pp",
    "pi-plus": "bin/pp"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bin",
    "completions",
    "docs",
    "examples",
    "extensions",
    "src"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "prepublishOnly": "npm test",
    "test": "node --test test/*.test.js",
    "start": "node bin/pp.js",
    "syntax": "node --check bin/pp.js && for f in src/*.js; do node --check \"$f\"; done"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "tmux",
    "tmux-session-manager",
    "remote-pi",
    "cli",
    "autostart",
    "systemd",
    "launchd",
    "pi-package"
  ],
  "author": "HardyDou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HardyDou/pi-plus.git"
  },
  "bugs": {
    "url": "https://github.com/HardyDou/pi-plus/issues"
  },
  "homepage": "https://github.com/HardyDou/pi-plus#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/pp-tmux.js"
    ]
  }
}
