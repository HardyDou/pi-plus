#compdef pp pi-plus
# zsh completion for pp (pi-plus)
_pp() {
  local -a commands
  commands=(
    'tui:full-screen panel of sessions and todos (alias panel)'
    'back:switch back to the pp tui panel (alias of the panel you came from)'
    'new:start a one-off session in a directory (alias n)'
    'n:alias for new'
    'create:alias for new'
    'up:start sessions in the background'
    'start:alias for up'
    'down:stop sessions'
    'rm:delete sessions (kill + drop the config entry)'
    'remove:alias for rm'
    'delete:alias for rm'
    'stop:alias for down'
    'restart:restart sessions'
    'status:show tmux/pi/remote-pi state'
    'ls:alias for status'
    'attach:attach to a session (starts it if needed)'
    'logs:print pane output'
    'send:type text into a pane'
    'mesh:remote-pi mesh (ls/send/resolve/inbox)'
    'audit:what changed on this machine, and when'
    'cron:schedule prompts and commands (once/every/crontab)'
    'todo:sessions waiting for a decision from you'
    'node:machines reached over ssh (ls/show/add/rm/test/exec/ssh)'
    'nodes:alias for node'
    'check:validate the config'
    'doctor:environment diagnostics'
    'init:write an example config'
    'install:install reboot autostart'
    'uninstall:remove autostart'
    'update:upgrade to the newest published version'
    'upgrade:alias for update'
    'alias:add another command name (ls/add/rm)'
    'link:alias for alias'
    'version:print version'
    'help:show help (help <command> for one command)'
  )

  _arguments -C \
    '(-c --config)'{-c,--config}'[config file]:file:_files' \
    '(-h --help)'{-h,--help}'[show help]' \
    '(-V --version)'{-V,--version}'[print version]' \
    '--socket[tmux socket name]:socket:' \
    '--json[machine-readable output]' \
    '--dry-run[print actions without touching tmux]' \
    '--force[recreate running sessions]' \
    '--reconcile[autostart mode: skip sessions stopped by hand]' \
    '--path[init destination]:file:_files' \
    '(-q --quiet)'{-q,--quiet}'[only errors]' \
    '(-v --verbose)'{-v,--verbose}'[echo tmux commands]' \
    '(-C --dir)'{-C,--dir}'[directory for pp new]:dir:_files -/' \
    '--agent[agent command for pp new]:command:' \
    '--log[keep output in ~/.pi/plus/logs]' \
    '--save[append the session to the config file]' \
    '(-a --attach)'{-a,--attach}'[attach after pp new]' \
    '--no-remote-pi[do not set a remote-pi name for pp new]' \
    '(-n --lines)'{-n,--lines}'[scrollback lines]:lines:' \
    '--no-enter[do not press Enter after send]' \
    '--as[mesh name to register as]:name:' \
    '--wait[mesh ACK timeout]:ms:' \
    '--reply[wait for a reply after the ACK]:ms:' \
    '--no-wait[do not wait for the mesh ACK]' \
    '--body-json[mesh body as JSON]:json:' \
    '--at[run once at an absolute time]:time:'
    '--in[run once after a delay]:duration:'
    '--every[repeat on an interval]:duration:'
    '--cron[repeat on a crontab expression]:expr:'
    '--command[run a shell command]:cmd:'
    '--catch-up[how late a missed run may be]:duration:'
    '--start[start the session if it is not running]'
    '--via[install backend]:backend:(crond)'
    '--all[ls: include finished todos]'
    '--now[tick: pretend it is this time]:time:'
    '--bin-dir[directory for pp alias symlinks]:dir:_files -/' \
    '--check[report only; exit 1 when an update is available]' \
    '--registry[npm registry for pp update]:url:' \
    '--watch[reconcile interval for install]:seconds:' \
    '--print[print autostart unit and exit]' \
    '1:command:->command' \
    '*:session:->session'

  case $state in
    command) _describe 'command' commands ;;
    session)
      local cfg=${(v)opt_args[(i)-c|--config]}
      [[ -z $cfg ]] && cfg=$HOME/.pi/plus.yml
      if [[ -r $cfg ]]; then
        local -a names
        names=(${(f)"$(sed -n 's/^[[:space:]-]*name:[[:space:]]*\([^[:space:]#]*\).*/\1/p' $cfg)"})
        _describe 'session' names
      fi
      ;;
  esac
}
_pp "$@"
